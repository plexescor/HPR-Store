import { Palette } from "./palette.slint";
import { StoreItem_S } from "./types.slint";
import { Card } from "./card.slint";

export { StoreItem_S }

component RefreshButton inherits Rectangle {
    in property <string> label: "REFRESH";
    in property <bool> primary: true;
    callback clicked;

    property <color> primary-accent: #38bdf8;

    width: button-label.preferred-width + 22px * Palette.scale;
    height: 30px * Palette.scale;
    border-radius: 7px * Palette.scale;
    border-width: 1px * Palette.scale;
    border-color: primary ? primary-accent.mix(#00000000, 0.30) : Palette.input-border;
    background: primary
        ? (button-area.pressed
            ? primary-accent.mix(#00000000, 0.22)
            : (button-area.has-hover
                ? primary-accent.mix(#00000000, 0.16)
                : primary-accent.mix(#00000000, 0.09)))
        : (button-area.pressed ? Palette.input-bg-press : (button-area.has-hover ? Palette.input-bg-hover : Palette.input-bg));

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    button-label := Text {
        text: root.label;
        color: root.primary ? root.primary-accent : Palette.text-secondary;
        font-size: 10.5px * Palette.scale;
        font-weight: 700;
        letter-spacing: 1px * Palette.scale;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component InstallButton inherits Rectangle {
    in property <string> label: "INSTALL";
    callback clicked;

    width: 96px * Palette.scale;
    height: 30px * Palette.scale;
    border-radius: 6px * Palette.scale;
    border-width: 1px * Palette.scale;

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    ta-install := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    states [
        pressed when ta-install.pressed: {
            background: #38bdf835;
            border-color: #38bdf880;
        }
        hovered when ta-install.has-hover: {
            background: #38bdf825;
            border-color: #38bdf860;
        }
        normal when !ta-install.has-hover: {
            background: #38bdf812;
            border-color: #38bdf835;
        }
    ]

    Text {
        text: root.label;
        font-size: 9.5px * Palette.scale;
        font-weight: 700;
        letter-spacing: 1.5px * Palette.scale;
        color: ta-install.pressed ? #e0f2fe : (ta-install.has-hover ? #bae6fd : #38bdf8);
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 100ms; }
    }
}

component BackButton inherits Rectangle {
    in property <string> label: "← BACK TO STORE";
    callback clicked;

    width: button-label.preferred-width + 20px * Palette.scale;
    height: 30px * Palette.scale;
    border-radius: 6px * Palette.scale;
    border-width: 1px * Palette.scale;
    border-color: Palette.card-border;
    background: ta-back.pressed ? Palette.input-bg-press : (ta-back.has-hover ? Palette.input-bg-hover : Palette.input-bg);

    animate background { duration: 100ms; }

    button-label := Text {
        text: root.label;
        color: Palette.text-secondary;
        font-size: 10px * Palette.scale;
        font-weight: 700;
        letter-spacing: 1px * Palette.scale;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta-back := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component StoreWindow inherits Window {
    title: "HPR Store";
    no-frame: false;
    background: Palette.background;
    default-font-size: 13px * Palette.scale;
    preferred-width: 780px * Palette.scale;
    preferred-height: 626px * Palette.scale;

    in property <[StoreItem_S]> storeItems;
    property <bool> showDetailView: false;
    property <StoreItem_S> selectedItem;

    // Pagination
    in property <int> totalItems: 0;
    in property <int> currentPage: 0;
    in property <int> totalPages: 1;
    // Sort: 0=none, 1=stars, 2=downloads
    in property <int> currentSort: 0;

    // Carousel & Preview images
    in property <[image]> selectedPreviewImages: [];
    in property <int> selectedPreviewImageCount: 0;
    in-out property <int> currentPreviewIndex: 0;
    in property <bool> previewLoading: false;

    // Type filter: 0=BOTH, 1=EXTENSION, 2=THEME
    in property <int> activeTypeFilter: 0;

    // Page jump state (private to UI)
    property <string> pageJumpText: "";
    property <bool> pageJumpInvalid: false;

    callback refresh-clicked();
    callback install-item-clicked(string);
    callback next-page-clicked();
    callback prev-page-clicked();
    callback go-to-page-clicked(string);  // C++ does int parsing & clamping
    callback sort-changed(int);
    callback item-selected(string);
    callback type-filter-changed(int);


    Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.background;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // ── Topbar ───────────────────────────────────────────────────
            topbar := Rectangle {
                height: !showDetailView && totalItems > 0
                    ? (totalPages > 1 ? 86px * Palette.scale : 78px * Palette.scale)
                    : 46px * Palette.scale;
                background: Palette.background;

                Rectangle {
                    y: parent.height - 1px * Palette.scale;
                    height: 1px * Palette.scale;
                    background: @linear-gradient(90deg, transparent 0%, Palette.divider 40%, Palette.divider 60%, transparent 100%);
                }

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // ── Row 1: Title + Refresh ──────────────────────────
                    HorizontalLayout {
                        height: 46px * Palette.scale;
                        padding-left: 18px * Palette.scale;
                        padding-right: 18px * Palette.scale;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px * Palette.scale;
                            alignment: start;

                            Text {
                                text: "HPR STORE";
                                color: Palette.text-primary;
                                font-size: 12px * Palette.scale;
                                font-weight: 700;
                                letter-spacing: 4px * Palette.scale;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px * Palette.scale;
                            alignment: end;

                            if !showDetailView : Rectangle {
                                width: 110px * Palette.scale;
                                height: 30px * Palette.scale;
                                border-radius: 6px * Palette.scale;
                                border-width: 1px * Palette.scale;
                                border-color: ta-filter.has-hover ? Palette.input-border-hover : Palette.input-border;
                                background: ta-filter.has-hover ? Palette.input-bg-hover : Palette.input-bg;
                                y: (parent.height - self.height) / 2;

                                HorizontalLayout {
                                    padding-left: 10px * Palette.scale;
                                    padding-right: 8px * Palette.scale;
                                    alignment: space-between;

                                    Text {
                                        text: activeTypeFilter == 0 ? "ALL" : (activeTypeFilter == 1 ? "EXTENSIONS" : "THEMES");
                                        font-size: 10px * Palette.scale;
                                        font-weight: 700;
                                        color: Palette.text-primary;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "▼";
                                        font-size: 8px * Palette.scale;
                                        color: Palette.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                filterPopup := PopupWindow {
                                    x: 0px;
                                    y: 32px * Palette.scale;
                                    width: 110px * Palette.scale;
                                    height: 84px * Palette.scale;
                                    close-policy: close-on-click-outside;

                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: Palette.card-background;
                                        border-radius: 6px * Palette.scale;
                                        border-width: 1px * Palette.scale;
                                        border-color: Palette.card-border;

                                        VerticalLayout {
                                            padding: 4px * Palette.scale;
                                            spacing: 2px * Palette.scale;

                                            // BOTH / ALL
                                            Rectangle {
                                                height: 24px * Palette.scale;
                                                border-radius: 4px * Palette.scale;
                                                background: ta-all.has-hover ? Palette.input-bg-hover : transparent;
                                                Text {
                                                    text: "ALL";
                                                    font-size: 9.5px * Palette.scale;
                                                    font-weight: 700;
                                                    color: activeTypeFilter == 0 ? #38bdf8 : Palette.text-secondary;
                                                    x: 8px * Palette.scale;
                                                    vertical-alignment: center;
                                                }
                                                ta-all := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.type-filter-changed(0); filterPopup.close(); }
                                                }
                                            }
                                            // EXTENSION
                                            Rectangle {
                                                height: 24px * Palette.scale;
                                                border-radius: 4px * Palette.scale;
                                                background: ta-ext.has-hover ? Palette.input-bg-hover : transparent;
                                                Text {
                                                    text: "EXTENSIONS";
                                                    font-size: 9.5px * Palette.scale;
                                                    font-weight: 700;
                                                    color: activeTypeFilter == 1 ? #38bdf8 : Palette.text-secondary;
                                                    x: 8px * Palette.scale;
                                                    vertical-alignment: center;
                                                }
                                                ta-ext := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.type-filter-changed(1); filterPopup.close(); }
                                                }
                                            }
                                            // THEME
                                            Rectangle {
                                                height: 24px * Palette.scale;
                                                border-radius: 4px * Palette.scale;
                                                background: ta-thm.has-hover ? Palette.input-bg-hover : transparent;
                                                Text {
                                                    text: "THEMES";
                                                    font-size: 9.5px * Palette.scale;
                                                    font-weight: 700;
                                                    color: activeTypeFilter == 2 ? #38bdf8 : Palette.text-secondary;
                                                    x: 8px * Palette.scale;
                                                    vertical-alignment: center;
                                                }
                                                ta-thm := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.type-filter-changed(2); filterPopup.close(); }
                                                }
                                            }
                                        }
                                    }
                                }

                                ta-filter := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { filterPopup.show(); }
                                }
                            }

                            RefreshButton {
                                label: "UPDATE DATABASE";
                                primary: true;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.refresh-clicked(); }
                            }
                        }
                    }

                    // ── Row 2: Sort + Pagination (only in list view with items) ──
                    if !showDetailView && totalItems > 0 : HorizontalLayout {
                        height: totalPages > 1 ? 36px * Palette.scale : 28px * Palette.scale;
                        padding-left: 18px * Palette.scale;
                        padding-right: 18px * Palette.scale;
                        padding-bottom: 6px * Palette.scale;
                        alignment: space-between;

                        // Sort buttons
                        HorizontalLayout {
                            spacing: 6px * Palette.scale;
                            alignment: start;

                            Rectangle {
                                width: sortStarsLabel.preferred-width + 18px * Palette.scale;
                                height: 22px * Palette.scale;
                                border-radius: 5px * Palette.scale;
                                border-width: 1px * Palette.scale;
                                border-color: currentSort == 1 ? #facc1560 : Palette.input-border;
                                background: currentSort == 1 ? #facc1518 : (sortStarsTA.has-hover ? Palette.input-bg-hover : Palette.input-bg);
                                animate background { duration: 100ms; }

                                sortStarsLabel := Text {
                                    text: "⭐ Stars";
                                    font-size: 9.5px * Palette.scale;
                                    font-weight: 700;
                                    color: currentSort == 1 ? #facc15 : Palette.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                sortStarsTA := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.sort-changed(currentSort == 1 ? 0 : 1); }
                                }
                            }

                            Rectangle {
                                width: sortDlLabel.preferred-width + 18px * Palette.scale;
                                height: 22px * Palette.scale;
                                border-radius: 5px * Palette.scale;
                                border-width: 1px * Palette.scale;
                                border-color: currentSort == 2 ? #38bdf860 : Palette.input-border;
                                background: currentSort == 2 ? #38bdf818 : (sortDlTA.has-hover ? Palette.input-bg-hover : Palette.input-bg);
                                animate background { duration: 100ms; }

                                sortDlLabel := Text {
                                    text: "↓ Downloads";
                                    font-size: 9.5px * Palette.scale;
                                    font-weight: 700;
                                    color: currentSort == 2 ? #38bdf8 : Palette.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                sortDlTA := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.sort-changed(currentSort == 2 ? 0 : 2); }
                                }
                            }

                            if currentSort != 0 : Rectangle {
                                width: sortDefaultLabel.preferred-width + 18px * Palette.scale;
                                height: 22px * Palette.scale;
                                border-radius: 5px * Palette.scale;
                                border-width: 1px * Palette.scale;
                                border-color: Palette.input-border;
                                background: sortDefaultTA.has-hover ? Palette.input-bg-hover : Palette.input-bg;
                                animate background { duration: 100ms; }

                                sortDefaultLabel := Text {
                                    text: "✕ Default";
                                    font-size: 9.5px * Palette.scale;
                                    font-weight: 700;
                                    color: Palette.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                sortDefaultTA := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.sort-changed(0); }
                                }
                            }
                        }

                        // Pagination controls (only when more than 1 page)
                        if totalPages > 1 : HorizontalLayout {
                            spacing: 6px * Palette.scale;
                            alignment: end;

                            // Prev button
                            Rectangle {
                                width: 28px * Palette.scale;
                                height: 22px * Palette.scale;
                                border-radius: 5px * Palette.scale;
                                border-width: 1px * Palette.scale;
                                border-color: currentPage == 0 ? Palette.divider : Palette.input-border;
                                background: currentPage == 0 ? Palette.background : (prevTA.has-hover ? Palette.input-bg-hover : Palette.input-bg);
                                animate background { duration: 100ms; }

                                Text {
                                    text: "←";
                                    font-size: 11px * Palette.scale;
                                    font-weight: 700;
                                    color: currentPage == 0 ? Palette.text-muted : Palette.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                prevTA := TouchArea {
                                    mouse-cursor: currentPage == 0 ? default : pointer;
                                    clicked => { if currentPage > 0 { root.prev-page-clicked(); } }
                                }
                            }

                            // Page indicator
                            Text {
                                text: "Page " + (currentPage + 1) + " / " + totalPages;
                                font-size: 9.5px * Palette.scale;
                                font-weight: 600;
                                color: Palette.text-secondary;
                                vertical-alignment: center;
                            }

                            // Page jump input
                            Rectangle {
                                width: 36px * Palette.scale;
                                height: 22px * Palette.scale;
                                border-radius: 5px * Palette.scale;
                                border-width: 1px * Palette.scale;
                                border-color: pageJumpInvalid ? #f8717160 : Palette.input-border;
                                background: Palette.input-bg;

                                pageJumpInput := TextInput {
                                    x: 4px * Palette.scale;
                                    width: parent.width - 8px * Palette.scale;
                                    height: parent.height;
                                    text <=> root.pageJumpText;
                                    font-size: 9.5px * Palette.scale;
                                    color: pageJumpInvalid ? #f87171 : Palette.text-primary;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    single-line: true;
                                    input-type: number;
                                }
                            }

                            // Apply page jump button
                            Rectangle {
                                width: applyLabel.preferred-width + 14px * Palette.scale;
                                height: 22px * Palette.scale;
                                border-radius: 5px * Palette.scale;
                                border-width: 1px * Palette.scale;
                                border-color: #38bdf840;
                                background: applyTA.has-hover ? #38bdf820 : #38bdf810;
                                animate background { duration: 100ms; }

                                applyLabel := Text {
                                    text: "GO";
                                    font-size: 9.5px * Palette.scale;
                                    font-weight: 700;
                                    color: #38bdf8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                applyTA := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if root.pageJumpText == "" {
                                            root.pageJumpInvalid = true;
                                        } else {
                                            root.pageJumpInvalid = false;
                                            // Pass raw string to C++ for int parsing, range clamping & validation
                                            root.go-to-page-clicked(root.pageJumpText);
                                            root.pageJumpText = "";
                                        }
                                    }
                                }
                            }

                            // Next button
                            Rectangle {
                                width: 28px * Palette.scale;
                                height: 22px * Palette.scale;
                                border-radius: 5px * Palette.scale;
                                border-width: 1px * Palette.scale;
                                border-color: currentPage >= totalPages - 1 ? Palette.divider : Palette.input-border;
                                background: currentPage >= totalPages - 1 ? Palette.background : (nextTA.has-hover ? Palette.input-bg-hover : Palette.input-bg);
                                animate background { duration: 100ms; }

                                Text {
                                    text: "→";
                                    font-size: 11px * Palette.scale;
                                    font-weight: 700;
                                    color: currentPage >= totalPages - 1 ? Palette.text-muted : Palette.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                nextTA := TouchArea {
                                    mouse-cursor: currentPage >= totalPages - 1 ? default : pointer;
                                    clicked => { if currentPage < totalPages - 1 { root.next-page-clicked(); } }
                                }
                            }
                        }
                    }
                }
            }

            // ── Main Content Container ──────────────────────────────────
            main-view := Rectangle {
                vertical-stretch: 1;

                // ── LIST VIEW ───────────────────────────────────────────
                if !showDetailView : Flickable {
                    viewport-height: storeContainer.preferred-height;
                    interactive: true;

                    storeContainer := VerticalLayout {
                        width: 100%;
                        padding: 16px * Palette.scale;
                        spacing: 12px * Palette.scale;

                        if storeItems.length == 0 : Card {
                            height: 80px * Palette.scale;
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "NO STORE ITEMS AVAILABLE";
                                    font-size: 10px * Palette.scale;
                                    font-weight: 700;
                                    letter-spacing: 2.5px * Palette.scale;
                                    color: Palette.text-muted;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        for item in storeItems : Card {
                            cardTouch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selectedItem = item;
                                    root.showDetailView = true;
                                    root.currentPreviewIndex = 0;
                                    root.item-selected(item.id);
                                }
                            }

                            VerticalLayout {
                                padding: 14px * Palette.scale;
                                spacing: 10px * Palette.scale;

                                // Header row (Name, Version, Type badge, Author)
                                HorizontalLayout {
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 10px * Palette.scale;

                                        Text {
                                            text: item.name;
                                            font-size: 14.5px * Palette.scale;
                                            font-weight: 700;
                                            color: Palette.text-primary;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            background: #38bdf815;
                                            border-width: 1px * Palette.scale;
                                            border-color: #38bdf840;
                                            border-radius: 4px * Palette.scale;
                                            height: 18px * Palette.scale;
                                            width: versionTxt.preferred-width + 10px * Palette.scale;
                                            y: (parent.height - self.height) / 2;

                                            versionTxt := Text {
                                                text: "v" + item.version;
                                                font-size: 9.5px * Palette.scale;
                                                font-weight: 700;
                                                color: #38bdf8;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            background: item.item-type == "EXTENSION" ? #c084fc15 : #a3e63515;
                                            border-width: 1px * Palette.scale;
                                            border-color: item.item-type == "EXTENSION" ? #c084fc40 : #a3e63540;
                                            border-radius: 4px * Palette.scale;
                                            height: 18px * Palette.scale;
                                            width: typeTxt.preferred-width + 10px * Palette.scale;
                                            y: (parent.height - self.height) / 2;

                                            typeTxt := Text {
                                                text: item.item-type;
                                                font-size: 9px * Palette.scale;
                                                font-weight: 700;
                                                letter-spacing: 1px * Palette.scale;
                                                color: item.item-type == "EXTENSION" ? #c084fc : #a3e635;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Text {
                                        text: "by " + item.author;
                                        font-size: 11px * Palette.scale;
                                        font-weight: 500;
                                        color: Palette.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                // Short Description (non-markdown)
                                Text {
                                    text: item.description;
                                    font-size: 11.5px * Palette.scale;
                                    font-weight: 500;
                                    color: Palette.text-secondary;
                                    wrap: word-wrap;
                                }

                                // Footer row (Stats & Install Button)
                                HorizontalLayout {
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 16px * Palette.scale;

                                        Text {
                                            text: "★ " + item.star-count;
                                            font-size: 10.5px * Palette.scale;
                                            color: #facc15;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "↓ " + item.download-count;
                                            font-size: 10.5px * Palette.scale;
                                            color: Palette.text-muted;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "Updated: " + item.last-updated;
                                            font-size: 10px * Palette.scale;
                                            color: Palette.text-dim;
                                            vertical-alignment: center;
                                        }
                                    }

                                    InstallButton {
                                        label: "INSTALL";
                                        clicked => { root.install-item-clicked(item.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── EXPANDED / MAXIMISED DETAIL VIEW ────────────────────
                if showDetailView : Flickable {
                    viewport-height: detailContainer.preferred-height;
                    interactive: true;

                    detailContainer := VerticalLayout {
                        width: 100%;
                        padding: 16px * Palette.scale;
                        spacing: 14px * Palette.scale;

                        Card {
                            VerticalLayout {
                                padding: 18px * Palette.scale;
                                spacing: 16px * Palette.scale;

                                // Action Bar (Back & Install)
                                HorizontalLayout {
                                    alignment: space-between;

                                    BackButton {
                                        clicked => { root.showDetailView = false; }
                                    }

                                    InstallButton {
                                        label: "INSTALL";
                                        clicked => { root.install-item-clicked(selectedItem.id); }
                                    }
                                }

                                Rectangle {
                                    height: 1px * Palette.scale;
                                    background: Palette.divider;
                                }

                                // Title & Author Section
                                VerticalLayout {
                                    spacing: 8px * Palette.scale;

                                    HorizontalLayout {
                                        spacing: 12px * Palette.scale;

                                        Text {
                                            text: selectedItem.name;
                                            font-size: 20px * Palette.scale;
                                            font-weight: 800;
                                            color: Palette.text-primary;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            background: #38bdf815;
                                            border-width: 1px * Palette.scale;
                                            border-color: #38bdf840;
                                            border-radius: 4px * Palette.scale;
                                            height: 20px * Palette.scale;
                                            width: dVersionTxt.preferred-width + 12px * Palette.scale;
                                            y: (parent.height - self.height) / 2;

                                            dVersionTxt := Text {
                                                text: "v" + selectedItem.version;
                                                font-size: 10px * Palette.scale;
                                                font-weight: 700;
                                                color: #38bdf8;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            background: selectedItem.item-type == "EXTENSION" ? #c084fc15 : #a3e63515;
                                            border-width: 1px * Palette.scale;
                                            border-color: selectedItem.item-type == "EXTENSION" ? #c084fc40 : #a3e63540;
                                            border-radius: 4px * Palette.scale;
                                            height: 20px * Palette.scale;
                                            width: dTypeTxt.preferred-width + 12px * Palette.scale;
                                            y: (parent.height - self.height) / 2;

                                            dTypeTxt := Text {
                                                text: selectedItem.item-type;
                                                font-size: 9.5px * Palette.scale;
                                                font-weight: 700;
                                                letter-spacing: 1px * Palette.scale;
                                                color: selectedItem.item-type == "EXTENSION" ? #c084fc : #a3e635;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px * Palette.scale;

                                        Text {
                                            text: "Author: " + selectedItem.author;
                                            font-size: 12px * Palette.scale;
                                            font-weight: 600;
                                            color: Palette.text-secondary;
                                        }

                                        if selectedItem.author-github != "" : Text {
                                            text: "(" + selectedItem.author-github + ")";
                                            font-size: 11px * Palette.scale;
                                            color: #38bdf8;
                                        }
                                    }
                                }

                                // Key Stats Row
                                Card {
                                    background: Palette.input-bg;
                                    border-color: Palette.input-border;

                                    HorizontalLayout {
                                        padding: 12px * Palette.scale;
                                        spacing: 24px * Palette.scale;
                                        alignment: space-around;

                                        Text {
                                            text: "★ Stars: " + selectedItem.star-count;
                                            font-size: 11.5px * Palette.scale;
                                            font-weight: 700;
                                            color: #facc15;
                                        }

                                        Text {
                                            text: "↓ Downloads: " + selectedItem.download-count;
                                            font-size: 11.5px * Palette.scale;
                                            font-weight: 700;
                                            color: Palette.text-primary;
                                        }

                                        Text {
                                            text: "Last Updated: " + selectedItem.last-updated;
                                            font-size: 11px * Palette.scale;
                                            color: Palette.text-secondary;
                                        }
                                    }
                                }

                                // Short Summary
                                VerticalLayout {
                                    spacing: 4px * Palette.scale;

                                    Text {
                                        text: "OVERVIEW";
                                        font-size: 9px * Palette.scale;
                                        font-weight: 800;
                                        letter-spacing: 2px * Palette.scale;
                                        color: Palette.text-muted;
                                    }

                                    Text {
                                        text: selectedItem.description;
                                        font-size: 12.5px * Palette.scale;
                                        font-weight: 500;
                                        color: Palette.text-primary;
                                        wrap: word-wrap;
                                    }
                                }

                                // Carousel Section (Only for THEME items when preview images exist or are loading)
                                if selectedItem.item-type == "THEME" && (selectedPreviewImageCount > 0 || previewLoading) : VerticalLayout {
                                    spacing: 6px * Palette.scale;

                                    Text {
                                        text: "THEME PREVIEW";
                                        font-size: 9px * Palette.scale;
                                        font-weight: 800;
                                        letter-spacing: 2px * Palette.scale;
                                        color: Palette.text-muted;
                                    }

                                    Card {
                                        height: 320px * Palette.scale;
                                        background: Palette.input-bg;
                                        border-color: Palette.input-border;
                                        clip: true;

                                        if previewLoading : Rectangle {
                                            Text {
                                                text: "Loading previews...";
                                                font-size: 13px * Palette.scale;
                                                color: Palette.text-muted;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        if !previewLoading && selectedPreviewImageCount > 0 : Rectangle {
                                            Image {
                                                width: 100%;
                                                height: 100%;
                                                source: root.selectedPreviewImages[root.currentPreviewIndex];
                                                image-fit: contain;
                                            }

                                            // Navigation controls (prev)
                                            if selectedPreviewImageCount > 1 : Rectangle {
                                                x: 12px * Palette.scale;
                                                y: (parent.height - self.height) / 2;
                                                width: 36px * Palette.scale;
                                                height: 36px * Palette.scale;
                                                border-radius: 18px * Palette.scale;
                                                background: (root.currentPreviewIndex <= 0)
                                                    ? #00000033
                                                    : (ta-carousel-prev.pressed ? #00000099 : (ta-carousel-prev.has-hover ? #00000077 : #00000055));
                                                border-width: 1px * Palette.scale;
                                                border-color: (root.currentPreviewIndex <= 0) ? #ffffff11 : #ffffff33;

                                                ta-carousel-prev := TouchArea {
                                                    enabled: root.currentPreviewIndex > 0;
                                                    mouse-cursor: self.enabled ? pointer : default;
                                                    clicked => { root.currentPreviewIndex -= 1; }
                                                }

                                                Text {
                                                    text: "‹";
                                                    font-size: 24px * Palette.scale;
                                                    font-weight: 700;
                                                    color: (root.currentPreviewIndex <= 0) ? #ffffff44 : #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Navigation controls (next)
                                            if selectedPreviewImageCount > 1 : Rectangle {
                                                x: parent.width - self.width - 12px * Palette.scale;
                                                y: (parent.height - self.height) / 2;
                                                width: 36px * Palette.scale;
                                                height: 36px * Palette.scale;
                                                border-radius: 18px * Palette.scale;
                                                background: (root.currentPreviewIndex >= selectedPreviewImageCount - 1)
                                                    ? #00000033
                                                    : (ta-carousel-next.pressed ? #00000099 : (ta-carousel-next.has-hover ? #00000077 : #00000055));
                                                border-width: 1px * Palette.scale;
                                                border-color: (root.currentPreviewIndex >= selectedPreviewImageCount - 1) ? #ffffff11 : #ffffff33;

                                                ta-carousel-next := TouchArea {
                                                    enabled: root.currentPreviewIndex < selectedPreviewImageCount - 1;
                                                    mouse-cursor: self.enabled ? pointer : default;
                                                    clicked => { root.currentPreviewIndex += 1; }
                                                }

                                                Text {
                                                    text: "›";
                                                    font-size: 24px * Palette.scale;
                                                    font-weight: 700;
                                                    color: (root.currentPreviewIndex >= selectedPreviewImageCount - 1) ? #ffffff44 : #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Detailed Documentation (Long Description)
                                VerticalLayout {
                                    spacing: 6px * Palette.scale;

                                    Text {
                                        text: "DOCUMENTATION & FEATURES";
                                        font-size: 9px * Palette.scale;
                                        font-weight: 800;
                                        letter-spacing: 2px * Palette.scale;
                                        color: Palette.text-muted;
                                    }

                                    Card {
                                        background: Palette.input-bg;
                                        border-color: Palette.input-border;

                                        VerticalLayout {
                                            padding: 14px * Palette.scale;

                                            StyledText {
                                                text: selectedItem.long-description;
                                            }
                                        }
                                    }
                                }

                                // Technical Specifications / Info
                                VerticalLayout {
                                    spacing: 8px * Palette.scale;

                                    Text {
                                        text: "TECHNICAL DETAILS";
                                        font-size: 9px * Palette.scale;
                                        font-weight: 800;
                                        letter-spacing: 2px * Palette.scale;
                                        color: Palette.text-muted;
                                    }

                                    VerticalLayout {
                                        spacing: 6px * Palette.scale;

                                        if selectedItem.download-url != "" : Text {
                                            text: "Download URL: " + selectedItem.download-url;
                                            font-size: 11px * Palette.scale;
                                            color: Palette.text-secondary;
                                            wrap: word-wrap;
                                        }

                                        if selectedItem.source-url != "" : Text {
                                            text: "Source Code: " + selectedItem.source-url;
                                            font-size: 11px * Palette.scale;
                                            color: Palette.text-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
